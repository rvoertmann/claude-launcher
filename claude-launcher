#!/usr/bin/env bash
#
# claude-launcher — tile VS Code + Terminal.app windows on the current Space,
# with each terminal running a Claude Code session in the target folder.
#
# All the tiling/VS Code/recording work lives in launcher-common.sh; this file
# only pins the Claude Code command each terminal runs. See that library and the
# README for the full picture.
#
# Usage:
#   claude-launcher [folder] [plugin-dir]
#     folder      defaults to the current directory
#     plugin-dir  optional; passed to each session as `claude --plugin-dir <dir>`
#
# Environment:
#   CLAUDE_LAUNCHER_LAYOUT   auto (default) | grid | stacked
#   CLAUDE_LAUNCHER_MIN_COL  minimum terminal width, in points, that `auto`
#                            requires before it chooses the grid (default 640)
set -euo pipefail

# Locate launcher-common.sh next to this script, following any symlinks (the
# script is normally symlinked onto PATH from ~/.local/bin).
_src="${BASH_SOURCE[0]}"
while [[ -h "$_src" ]]; do
  _dir="$(cd -P "$(dirname "$_src")" && pwd)"
  _src="$(readlink "$_src")"
  [[ "$_src" != /* ]] && _src="$_dir/$_src"
done
_dir="$(cd -P "$(dirname "$_src")" && pwd)"
# shellcheck source=launcher-common.sh
source "$_dir/launcher-common.sh"

LAUNCHER_NAME="claude-launcher"
LAUNCHER_ENV_PREFIX="CLAUDE_LAUNCHER"
LAUNCHER_USAGE="Usage: claude-launcher [folder] [plugin-dir]   (folder defaults to the current directory)"
LAUNCHER_RECORD="1"   # record each launch so `claude-launcher-close` can tear it down

# launcher_build_command <folder> [plugin-dir]
#   Command each terminal runs after cd'ing into <folder>. Prefer `claude` on
#   PATH, fall back to the known install location under ~/.local/bin. Each
#   session runs under `caffeinate -i` so the Mac stays awake for as long as
#   that terminal's Claude session is running (the assertion is released the
#   moment the command exits). An optional plugin dir is passed via
#   `--plugin-dir`.
launcher_build_command() {
  local folder="$1"
  local pluginDir="${2:-}"

  if [[ -n "$pluginDir" ]]; then
    if [[ ! -d "$pluginDir" ]]; then
      echo "claude-launcher: plugin directory '$pluginDir' is not a directory" >&2
      echo "$LAUNCHER_USAGE" >&2
      exit 1
    fi
    pluginDir="$(cd "$pluginDir" && pwd)"
  fi

  local claudeArgs="--dangerously-skip-permissions"
  [[ -n "$pluginDir" ]] && claudeArgs+=" --plugin-dir $(printf '%q' "$pluginDir")"

  printf '%s' \
    "{ command -v claude >/dev/null 2>&1 && caffeinate -i claude $claudeArgs; } || caffeinate -i \"\$HOME/.local/bin/claude\" $claudeArgs"
}

launcher_main "$@"
