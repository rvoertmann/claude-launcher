#!/usr/bin/env bash
#
# claude-launcher-session — run a command inside an invisible tmux session.
#
# The launcher starts each terminal with this instead of running the AI CLI
# directly. The tab still looks like a plain terminal (see
# tmux/claude-launcher.tmux.conf for how tmux is made invisible), but the
# session's screen is now shared, so `claude-launcher-mirror` can show a
# read-only live copy of it on the overview desktop.
#
# This script OWNS the session. The user's rule is that nothing survives in the
# background: when the hosting window or tab goes away, the session and its
# mirror must die with it. Closing an iTerm2 window sends SIGHUP to the
# foreground process group, so the trap below is what actually enforces that.
# It cannot be left to tmux's own `destroy-unattached`, because the mirror is a
# second, still-attached client on a grouped session — killing the primary
# session alone would leave the mirror holding the shared window open, and the
# `claude` process alive inside it.
#
# Usage:
#   claude-launcher-session <session-name> <command> [args...]
#
# Example:
#   claude-launcher-session claude-launcher-1 claude --plugin-dir ~/plugins
set -euo pipefail

# The socket every launcher session and mirror shares. Isolated from the user's
# own tmux server, which lives on the default socket.
readonly SOCKET="claudelauncher"

# Locate the tmux config next to this script, following any symlinks (the
# script is normally symlinked onto PATH from ~/.local/bin).
_src="${BASH_SOURCE[0]}"
while [[ -h "$_src" ]]; do
  _dir="$(cd -P "$(dirname "$_src")" && pwd)"
  _src="$(readlink "$_src")"
  [[ "$_src" != /* ]] && _src="$_dir/$_src"
done
_dir="$(cd -P "$(dirname "$_src")" && pwd)"
readonly CONF="$_dir/tmux/claude-launcher.tmux.conf"

# Prefer tmux on PATH, fall back to the Homebrew location (a GUI-launched
# terminal does not always inherit a PATH with /opt/homebrew/bin on it).
TMUX_BIN="$(command -v tmux || true)"
[[ -n "$TMUX_BIN" ]] || TMUX_BIN="/opt/homebrew/bin/tmux"
readonly TMUX_BIN

if [[ $# -lt 2 ]]; then
  printf 'Usage: claude-launcher-session <session-name> <command> [args...]\n' >&2
  exit 64
fi
if [[ ! -x "$TMUX_BIN" ]]; then
  printf 'claude-launcher-session: tmux not found (looked on PATH and at /opt/homebrew/bin/tmux)\n' >&2
  exit 69
fi
if [[ ! -r "$CONF" ]]; then
  printf 'claude-launcher-session: missing tmux config at %s\n' "$CONF" >&2
  exit 69
fi

session="$1"
shift
mirror="${session}__mirror"

# Every target below is written `=name`: tmux would otherwise accept a prefix
# or fnmatch match, and `-t claude-1` could then resolve to `claude-1__mirror`.
# `=` forces an exact name match.

# tmux_cmd <args...>
#   Run a tmux command against the launcher's socket. `-f` is only honoured
#   when this invocation is the one that starts the server, but passing it
#   always means whichever process wins that race configures it correctly —
#   and, just as importantly, that the user's ~/.tmux.conf is never read.
tmux_cmd() {
  "$TMUX_BIN" -L "$SOCKET" -f "$CONF" "$@"
}

client_pid=""

# cleanup — tear down this session and its mirror, then exit with the status we
#   arrived with. Killing an already-dead session (the normal case when the
#   user simply quits Claude Code, which ends the session by itself) is not an
#   error: both kills are allowed to fail. Nor is a server that has already
#   exited, which is why stderr is discarded rather than inspected.
cleanup() {
  local status=$?
  # Disarm first: cleanup exits, and re-entering it from the EXIT trap while
  # already running it would recurse.
  trap - EXIT HUP TERM INT
  # Mirror first. The mirror is the session that keeps the shared window — and
  # therefore the `claude` process — alive after the primary is gone.
  "$TMUX_BIN" -L "$SOCKET" kill-session -t "=$mirror" 2>/dev/null || true
  "$TMUX_BIN" -L "$SOCKET" kill-session -t "=$session" 2>/dev/null || true
  # Killing the session detaches the client, which then exits on its own; this
  # is only for the case where the server was already gone and it is still
  # sitting there.
  [[ -n "$client_pid" ]] && kill "$client_pid" 2>/dev/null || true
  exit "$status"
}
trap cleanup EXIT HUP TERM INT

# Create-or-attach, in one step. `-A` makes this idempotent: re-running the
# launcher for an existing session name reattaches to it rather than failing.
#
# Not `exec`: this process has to outlive the tmux client so that its trap can
# run the teardown above.
#
# Backgrounded and waited on, rather than run in the foreground, because bash
# defers a trap until the running foreground command finishes — so with a
# foreground client, `kill -HUP <this pid>` would sit there doing nothing until
# the session ended by itself. (Measured: it does nothing at all.) The usual
# window-close path still works either way, since a tty hangup goes to the whole
# foreground process group and takes the client down too, but the teardown must
# not depend on the signal reaching a second process.
#
# The explicit `<&3` is required: with job control off, which is the case for a
# non-interactive shell, bash redirects an async command's stdin from /dev/null
# unless told otherwise — and a tmux client with no terminal on stdin is not a
# tmux client. Job control being off also means the client stays in this
# script's process group, so it remains the terminal's foreground process group
# and reads the tty without stopping on SIGTTIN.
exec 3<&0
tmux_cmd new-session -A -s "$session" -- "$@" <&3 &
client_pid=$!

# Hand the client's exit status back to the caller, so a launcher tab that ends
# because Claude Code failed still reports that failure.
client_status=0
wait "$client_pid" || client_status=$?
exit "$client_status"
